MANGAI_ENVIRONMENT=development
MANGAI_DATA_DIR=.data
MANGAI_WORKER_CACHE_DIR=.cache
MANGAI_WORKER_POLL_INTERVAL_SECONDS=2.0

# Provider selection:
# Detection: ocr | comic_text_detector
# OCR: fallback | paddleocr | mangaocr | azure_vision
# Translation: fallback | azure_translator | deepl
MANGAI_DETECTION_PROVIDER=ocr
MANGAI_OCR_PROVIDER=fallback
MANGAI_TRANSLATION_PROVIDER=fallback
MANGAI_STRICT_PROVIDER_SELECTION=false
MANGAI_HTTP_TIMEOUT_SECONDS=30.0

# Comic text detector
MANGAI_COMIC_TEXT_DETECTOR_MODEL_PATH=.cache/comic-text-detector/comictextdetector.pt.onnx

# Azure Vision OCR
# Example value:
# MANGAI_AZURE_VISION_READ_URL=https://<resource>.cognitiveservices.azure.com/vision/v3.2/read/analyze
MANGAI_AZURE_VISION_READ_URL=
MANGAI_AZURE_VISION_API_KEY=
MANGAI_AZURE_VISION_POLL_INTERVAL_SECONDS=1.0

# Azure Translator
MANGAI_AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
MANGAI_AZURE_TRANSLATOR_API_KEY=
MANGAI_AZURE_TRANSLATOR_REGION=

# DeepL
MANGAI_DEEPL_API_BASE_URL=https://api-free.deepl.com/v2
MANGAI_DEEPL_API_KEY=
